    "from pyspark.sql.functions import col, when, count, isnan\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# ✅ All 30 numerical features (hardcoded)\n",
    "selected_features = [\n",
    "    'radius_mean', 'texture_mean', 'perimeter_mean', 'area_mean', 'smoothness_mean',\n",
    "    'compactness_mean', 'concavity_mean', 'concave points_mean', 'symmetry_mean', 'fractal_dimension_mean',\n",
    "    'radius_se', 'texture_se', 'perimeter_se', 'area_se', 'smoothness_se',\n",
    "    'compactness_se', 'concavity_se', 'concave points_se', 'symmetry_se', 'fractal_dimension_se',\n",
    "    'radius_worst', 'texture_worst', 'perimeter_worst', 'area_worst', 'smoothness_worst',\n",
    "    'compactness_worst', 'concavity_worst', 'concave points_worst', 'symmetry_worst', 'fractal_dimension_worst'\n",
    "]\n",
    "\n",
    "target_col = \"label\"\n",
    "\n",
    "# ✅ Step 1: Drop 'id' and convert 'diagnosis' to label\n",
    "bc_df = bc_df.drop(\"id\")\n",
    "bc_df = bc_df.withColumn(\"label\", when(col(\"diagnosis\") == \"M\", 1.0).otherwise(0.0))\n",
    "bc_df = bc_df.drop(\"diagnosis\")\n",
    "\n",
    "# ✅ Step 2: Data Quality Check\n",
    "def data_quality_check(df):\n",
    "    print(\"1️⃣ Missing Values Analysis:\")\n",
    "    missing_counts = df.select([\n",
    "        count(when(col(c).isNull() | isnan(c), c)).alias(c) for c in df.columns\n",
    "    ])\n",
    "    missing_counts.show()\n",
    "\n",
    "    total_rows = df.count()\n",
    "    print(\"\\nMissing Values Percentage:\")\n",
    "    row = missing_counts.collect()[0]\n",
    "    for c in df.columns:\n",
    "        missing = row[c]\n",
    "        if missing > 0:\n",
    "            percentage = (missing / total_rows) * 100\n",
    "            print(f\"❗ {c}: {percentage:.2f}% missing ({missing:,} rows)\")\n",
    "\n",
    "data_quality_check(bc_df)\n",
    "\n",
    "# ✅ Step 3: Create Clean Dataset\n",
    "print(\"\\n3️⃣ Creating Clean Dataset...\")\n",
    "model_data = bc_df.select(selected_features + [target_col])\n",
    "rows_before = model_data.count()\n",
    "model_data = model_data.na.drop()\n",
    "rows_after = model_data.count()\n",
    "\n",
    "print(f\"Rows before cleaning: {rows_before:,}\")\n",
    "print(f\"Rows after cleaning: {rows_after:,}\")\n",
    "print(f\"Rows removed: {rows_before - rows_after:,} ({((rows_before - rows_after)/rows_before)*100:.2f}%)\")\n",
    "\n",
    "# ✅ Step 4: Distribution Plot\n",
    "pdf = model_data.toPandas()\n",
    "\n",
    "print(\"\\n4️⃣ Plotting Distributions...\")\n",
    "plt.figure(figsize=(20, 16))\n",
    "for i, feature in enumerate(selected_features + [target_col], 1):\n",
    "    plt.subplot(6, 6, i)\n",
    "    sns.histplot(pdf[feature], kde=True, bins=30)\n",
    "    plt.title(feature, fontsize=9)\n",
    "    plt.xticks(fontsize=6)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# ✅ Step 5: Correlation Analysis\n",
    "print(\"\\n5️⃣ Feature Correlation Matrix:\")\n",
    "corr_matrix = pdf.corr(numeric_only=True)\n",
    "\n",
    "plt.figure(figsize=(18, 14))\n",
    "sns.heatmap(corr_matrix, cmap='coolwarm', center=0)\n",
    "plt.title('Correlation Heatmap')\n",
    "plt.show()\n",
    "\n",
    "print(\"\\nCorrelations with target (label):\")\n",
    "label_corr = corr_matrix[\"label\"].sort_values(ascending=False)\n",
    "for feature, corr in label_corr.items():\n",
    "    if feature != \"label\":\n",
    "        print(f\"{feature}: {corr:.3f}\")\n",
    "\n",
    "# ✅ Step 6: Validation – Check for invalid negatives\n",
    "print(\"\\n6️⃣ Data Validation Checks:\")\n",
    "for feature in selected_features:\n",
    "    neg_count = model_data.filter(col(feature) < 0).count()\n",
    "    if neg_count > 0:\n",
    "        print(f\"⚠️ Warning: {neg_count} negative values in {feature}\")\n",
    "\n",
    "# ✅ Step 7: Preview Final Dataset\n",
    "print(\"\\n7️⃣ Final Clean Dataset Preview:\")\n",
    "model_data.show(5)\n",
    "\n",
    "print(\"\\n✅ Data preprocessing completed successfully!\")\n"
