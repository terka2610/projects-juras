    "from sklearn.datasets import load_breast_cancer\n",
    "from sklearn.model_selection import KFold\n",
    "from pyspark.ml.feature import VectorAssembler\n",
    "from pyspark.ml.classification import RandomForestClassifier, MultilayerPerceptronClassifier, LinearSVC\n",
    "from pyspark.ml.evaluation import MulticlassClassificationEvaluator\n",
    "\n",
    "# Load and rename target column to 'label'\n",
    "data = load_breast_cancer()\n",
    "df = pd.DataFrame(data.data, columns=data.feature_names)\n",
    "df[\"label\"] = data.target  # Ensure the column is named 'label'\n",
    "\n",
    "# Clean the DataFrame\n",
    "df_cleaned = df.dropna().drop_duplicates()\n",
    "\n",
    "# Set feature columns (drop 'label')\n",
    "columns = df_cleaned.drop(\"label\", axis=1).columns\n",
    "\n",
    "# Set up KFold\n",
    "kf = KFold(n_splits=20, shuffle=True, random_state=42)\n",
    "\n",
    "# Run one fold only\n",
    "for fold, (train_idx, test_idx) in enumerate(kf.split(df_cleaned)):\n",
    "    print(f\"Fold {fold + 1} (Single Fold Only)\")\n",
    "\n",
    "    train_df = df_cleaned.iloc[train_idx]\n",
    "    test_df = df_cleaned.iloc[test_idx]\n",
    "\n",
    "    # Convert to Spark DataFrame\n",
    "    train_sdf = spark.createDataFrame(train_df)\n",
    "    test_sdf = spark.createDataFrame(test_df)\n",
    "\n",
    "    # Assemble features\n",
    "    assembler = VectorAssembler(inputCols=columns.tolist(), outputCol=\"features\")\n",
    "    train_data = assembler.transform(train_sdf).select(\"features\", \"label\")\n",
    "    test_data = assembler.transform(test_sdf).select(\"features\", \"label\")\n",
    "\n",
    "    # Evaluator\n",
    "    evaluator = MulticlassClassificationEvaluator(labelCol=\"label\", predictionCol=\"prediction\", metricName=\"accuracy\")\n",
    "\n",
    "    # Random Forest\n",
    "    rf = RandomForestClassifier(labelCol=\"label\", featuresCol=\"features\", numTrees=100)\n",
    "    rf_model = rf.fit(train_data)\n",
    "    rf_preds = rf_model.transform(test_data)\n",
    "    rf_acc = evaluator.evaluate(rf_preds)\n",
    "    print(f\"  Random Forest Accuracy: {rf_acc:.4f}\")\n",
    "\n",
    "    # Neural Network\n",
    "    nn = MultilayerPerceptronClassifier(labelCol=\"label\", featuresCol=\"features\", layers=[30, 15, 2], maxIter=100)\n",
    "    nn_model = nn.fit(train_data)\n",
    "    nn_preds = nn_model.transform(test_data)\n",
    "    nn_acc = evaluator.evaluate(nn_preds)\n",
    "    print(f\"  Neural Net Accuracy: {nn_acc:.4f}\")\n",
    "\n",
    "    # SVM\n",
    "    svm = LinearSVC(labelCol=\"label\", featuresCol=\"features\", maxIter=100)\n",
    "    svm_model = svm.fit(train_data)\n",
    "    svm_preds = svm_model.transform(test_data)\n",
    "    svm_acc = evaluator.evaluate(svm_preds)\n",
    "    print(f\"  SVM Accuracy: {svm_acc:.4f}\")\n",
    "\n",
    "\n"
