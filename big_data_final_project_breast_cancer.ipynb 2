    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "# --- Example: replace with your actual scores if not yet defined ---\n",
    "# rfc_scores = [0.94, 0.95, ..., 0.97]  # list of 20 accuracies from CV\n",
    "# nn_scores = [0.92, 0.93, ..., 0.96]\n",
    "# svm_scores = [0.90, 0.91, ..., 0.95]\n",
    "\n",
    "# --- Create DataFrame from model scores ---\n",
    "results_df = pd.DataFrame({\n",
    "    \"Random Forest\": rfc_scores,\n",
    "    \"Neural Network\": nn_scores,\n",
    "    \"SVM\": svm_scores\n",
    "})\n",
    "\n",
    "# --- Melt for seaborn plotting ---\n",
    "melted_df = results_df.melt(var_name=\"Model\", value_name=\"Accuracy\")\n",
    "\n",
    "# --- Boxplot of Accuracy Distribution ---\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.boxplot(data=melted_df, x=\"Model\", y=\"Accuracy\", palette=\"Set2\")\n",
    "plt.title(\"Accuracy Distribution per Model (20-Fold CV)\")\n",
    "plt.ylim(0.85, 1.01)\n",
    "plt.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "plt.show()\n",
    "\n",
    "# --- Line Plot per Fold ---\n",
    "plt.figure(figsize=(10, 6))\n",
    "for model in results_df.columns:\n",
    "    plt.plot(range(1, 21), results_df[model], label=model, marker='o')\n",
    "plt.title(\"Accuracy per Fold\")\n",
    "plt.xlabel(\"Fold\")\n",
    "plt.ylabel(\"Accuracy\")\n",
    "plt.ylim(0.85, 1.01)\n",
    "plt.legend()\n",
    "plt.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "plt.show()\n",
    "\n",
    "# --- Bar Plot of Mean Accuracy ---\n",
    "mean_accuracies = results_df.mean().sort_values(ascending=False)\n",
    "plt.figure(figsize=(8, 5))\n",
    "sns.barplot(x=mean_accuracies.index, y=mean_accuracies.values, palette=\"pastel\")\n",
    "plt.title(\"Average Accuracy per Model\")\n",
    "plt.ylabel(\"Accuracy\")\n",
    "plt.ylim(0.85, 1.01)\n",
    "plt.grid(True, axis='y', linestyle=\"--\", alpha=0.5)\n",
    "plt.show()\n",
    "\n",
    "# --- Violin Plot (optional advanced view) ---\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.violinplot(data=melted_df, x=\"Model\", y=\"Accuracy\", inner=\"point\", palette=\"muted\")\n",
    "plt.title(\"Accuracy Distribution with Density (Violin Plot)\")\n",
    "plt.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "plt.show()\n",
    "\n",
    "# --- Error Bar Plot: Mean ± Standard Deviation ---\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.errorbar(mean_accuracies.index, mean_accuracies.values,\n",
    "             yerr=results_df.std().values, fmt='o', capsize=5, color='black')\n",
    "plt.title(\"Mean Accuracy with Standard Deviation\")\n",
    "plt.ylabel(\"Accuracy\")\n",
    "plt.ylim(0.85, 1.01)\n",
    "plt.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "plt.show()\n"
   ]
